	// Macro Globals
	
	int	m_PullUp, m_Ascend,	m_Descend, m_AutoPilotOn, m_AutoPilotOff;

	int initDevMacros() {

		// MACRO: Emergency Pull Up								Duration = 1050
		m_PullUp = CHAIN(
			LOCK+DOWN+PitchUp, D(150),
			UP+PitchUp, D(),
			DOWN+ThrustUp, D(500),
			UP+ThrustUp, D(),
			DOWN+PitchDown, D(),
			UP+PitchDown, D(),
			LOCK);
			
		// MACRO: Raise our altitude							Duration = 620
		m_Ascend = CHAIN(
			LOCK+PULSE+PitchUp, D(),
			DOWN+ThrustUp, D(250),
			UP+ThrustUp, D(),
			PULSE+PitchDown, D(),
			LOCK);
			
		// MACRO: Decrease our altitude							Duration = 620
		m_Descend = CHAIN(
			LOCK+PULSE+PitchDown, D(),
			DOWN+ThrustDown, D(250),
			UP+ThrustDown, D(),
			PULSE+PitchUp, D(),
			LOCK);
			
		// MACRO: Send APON to the Journal Processor
		m_AutoPilotOn = CHAIN(
			LOCK+PULSE+QuickCommsPanel, D(),
			PULSE+'!', D(),
			PULSE+'s', D(),
			PULSE+'e', D(),
			PULSE+'t', D(),
			PULSE+' ', D(),
			PULSE+'A', D(),
			PULSE+'P', D(),
			PULSE+' ', D(),
			PULSE+'O', D(),
			PULSE+'N', D(),			
			PULSE+QuickCommsPanel, D(500),
			LOCK);

		// MACRO: Send APOFF to the Journal Processor		
		m_AutoPilotOff = CHAIN(
			LOCK+PULSE+QuickCommsPanel, D(),
			PULSE+'!', D(),
			PULSE+'s', D(),
			PULSE+'e', D(),
			PULSE+'t', D(),
			PULSE+' ', D(),
			PULSE+'A', D(),
			PULSE+'P', D(),
			PULSE+' ', D(),
			PULSE+'O', D(),
			PULSE+'F', D(),
			PULSE+'F', D(),
			PULSE+QuickCommsPanel, D(500),
			LOCK);
	}
	
	//	NOTE:		This functionality is available via SRVSurvey
	//	FUNCTION:	Autopilot guides ship in direction of target using 'DestHeading' and 'DestDistance' from MyJournalData.json - UNDER DEVELOPMENT 
	//	USAGE:		Use "!set <command>" in ED Chat window to enter an input command
	//				Example: "!set LAT -17.536" then "!set LON 54.321"
	//				"!Set AP ON" and powershell script will grab our current LAT/LON and calc heading and distance every 5 seconds until "!set AP OFF"
	//				destHeading and destDistance will be written to MyJournalData.json for us to use here 
	
	//	Global VARS
	
	int		myHeading;				// fnAutoPilot() Current heading of ship
	int		destHeading = 0;		// fnAutoPilot() Target heading
	int		destDistance = 0;		// fnAutoPilot() Target distance
	int		AutoPilot = OFF;		// AutoPilot flag

	int fnAutoPilot(int dummy = 0) {
	
		myHeading = stfnGetKeyValue("Heading", INTEGER);				// grab from status.json 
		destHeading = stfnGetKeyValue("destHeading", INTEGER, 1);		// grab from MyJournalData.json
		destDistance = stfnGetKeyValue("destDistance", INTEGER, 1);		// grab from MyJournalData.json
		
		if (DEBUG >= 1) {
			printf("!!	DEBUG:	fnAutoPilot() - myHeading	= %d\x0a", myHeading);
			printf("!!	DEBUG:	fnAutoPilot() - destHeading	= %d\x0a", destHeading);
			printf("!!	DEBUG:	fnAutoPilot() - destDistance	= %d\x0a", destDistance);
		}

		// sprintf char array or alias to say or overlay "Head: <destHeading>"
		// sprintf char array or alias to say or overlay "Dist: <destDistance>"
	
	}


	//	NOTE:		This functionality is available via SRVSurvey
	//	TOGGLE:		Toggle Auto Pilot ON/OFF 
	//	Parameter:	dummy - enables delayed or repeat calls from REXEC() and DeferCall()
	
	//	GLOBAL Vars
	
	int APStatus = 0;
		
	int tgAutoPilot(int dummy = 0) {

		if (APStatus) {
			APStatus = 0;
	//-		DeferCall(4500, &fnVPOutput, "Auto pilot OFF");		// delay should be slightly longer than the macro run time 
	//-		ActKey(KEYON+PULSE+m_AutoPilotOff);
		}
		else {
			APStatus = 1;
	//-		DeferCall(4500, &fnVPOutput, "Auto pilot");			// delay should be slightly longer than the macro run time 
	//-		ActKey(KEYON+PULSE+m_AutoPilotOn);			
		}
	}


	// TOGGLE:		Toggle Terrain Following feature
	// Parameter:	Engage - No parameter parsed = toggle TF
	//				Allow other conditions to DISENGAGE 

	// Globals:
	int TerrainFollow		= 0;								// Global Flag to track Terrain Following ON/OFF	
	
	int tgTerrainFollow(int Engage = ON) {
		int SetAltitude;
		char myAltitude;
		Dim(&myAltitude, 40);
		myAltitude[0] = 0;
		
		if (Engage == ON) {		
			TerrainFollow = ON;												// Flip the flag each time I+U+APENG is pressed
			SetAltitude = stfnGetKeyValue("Altitude", INTEGER);				// Use current altitude to set MinHeight
			if (DEBUG >= LOG) printf("!!	DEBUG: tgTerrainFollow() - TF SetAltitude %d meters\x0a", SetAltitude);
		}
		else {
			TerrainFollow = OFF;
		}
		if (TerrainFollow & fMainShip) {
			if (fAltFromAvgRad == 0) {										// Must be below orbital cruise
				AutoRepeat(hTerrain, 1500, &fnTerrainFollow, SetAltitude);	// 
				sprintf(&myAltitude, "T F %d meters", SetAltitude);
				fnVPOutput(&myAltitude);
			}
		}
		else {
			StopAutoRepeat(hTerrain);
			fnVPOutput("T F Disengaged");
		}
	}


	// FUNCTION: 	Auto Pilot Terrain Following feature - UNDER DEVELOPMENT
	// Parameters:	MinHeight	- Minimum altitude in meters we want to follow (sets MinHeight to 100 if not parsed
	//				MaxHeight	- Max altitude in meters

	// WARNING:		Using CHAIN inside a REXEC or AutoRepeat is forbidden!
	
	int fnTerrainFollow(int MinHeight = 100) {
		int MaxHeight = MinHeight + 20;
		int Altitude = stfnGetKeyValue("Altitude", INTEGER);

		if (DEBUG >= LOG) printf("!!!	DEBUG: tgTerrainFollow() - Min %d, Max %d, ALT %d\x0a", MinHeight, MaxHeight, Altitude);

		if (Altitude < (MinHeight + 15)) {
			// ABORT
			tgTerrainFollow(OFF);
		}
		// Stay between MinHeight and MaxHeight
		if (Altitude <= (MinHeight-5)) {
			fnLowAltitude();
		}
		if (Altitude < (MinHeight+6)) {
			fnAscend();
		}
		if (Altitude >= MaxHeight) {
			fnDescend();
		}
		// maybe track rise/fall to smooth pitch and up/down?
	}

	int fnLowAltitude() {
		fnSoundFX("AltWarning");							// Warning horn (duration 1 second) - may need tweaking
		printf("^^	Pull up	^^\x0a");
		// Increase altitude using PitchUp and ThrustUp
		ActKey(KEYON+PULSE+m_PullUp);						// Duration = DelayTime(100)*3 + 1000 = 1300
	}
	
	int fnAscend() {
		printf("^^	Increase altitude	^^\x0a");
		// Increase altitude using PitchUp and ThrustUp
		ActKey(KEYON+PULSE+m_Ascend);						// Duration = DelayTime(100)*3 + 1000 = 1300	
	}
	
	int fnDescend() {
		printf("--	Decrease Altitude	--\x0a");
		// Decrease altitude using PitchDown and ThrustDown
		ActKey(KEYON+PULSE+m_Descend);						// Duration = DelayTime(100)*3 + 500 = 800
	}

